{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/enterprise",
      "destination": "/enterprise.html"
    },
    {
      "source": "/monitor",
      "destination": "/monitor.html"
    },
    {
      "source": "/users",
      "destination": "/users.html"
    },
    {
      "source": "/stores",
      "destination": "/stores.html"
    },
    {
      "source": "/sync",
      "destination": "/sync.html"
    },
    {
      "source": "/access",
      "destination": "/access.html"
    },
    {
      "source": "/catalog-enterprise",
      "destination": "/catalog-enterprise.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}